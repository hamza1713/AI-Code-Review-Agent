# Google Gemini API Key (Required for multi-agent LLM reasoning)
# Get your API key from: https://aistudio.google.com/
GEMINI_API_KEY=

# LLM Model Identifier (Default: gemini/gemini-3.1-flash-lite-preview)
LLM_MODEL=gemini/gemini-3.1-flash-lite-preview

# Maximum Tokens per LLM response (Default: 4096)
MAX_TOKENS=4096

# GitHub Authentication (Required for live GitHub PR reviews and inline commenting)
# Personal Access Token or GitHub App Token with 'repo' and 'pull_requests:write' scopes
GITHUB_TOKEN=your_github_personal_access_token_here

# GitHub Webhook Secret (Required for FastAPI webhook signature validation)
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Serper API Key (Optional: for live AppSec/OWASP web search)
# Get your API key from: https://serper.dev
SERPER_API_KEY=
