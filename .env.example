# Google Gemini API Key (Required for multi-agent LLM reasoning)
# Get your API key from: https://aistudio.google.com/
GEMINI_API_KEY=

# LLM Model Identifier (Default: gemini/gemini-3.1-flash-lite-preview)
LLM_MODEL=gemini/gemini-3.1-flash-lite-preview

# Maximum Tokens per LLM response (Default: 4096)
MAX_TOKENS=4096

# GitHub Authentication (Required for live GitHub PR reviews and inline commenting)
# Personal Access Token or GitHub App Token with 'repo' and 'pull_requests:write' scopes
GITHUB_TOKEN=your_github_personal_access_token_here

# GitHub Webhook Secret (Required for FastAPI webhook signature validation)
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Serper API Key (Optional: for live AppSec/OWASP web search)
# Get your API key from: https://serper.dev
SERPER_API_KEY=

# ── Semantic RAG Context Engine ─────────────────────────────────────────────
# Retrieves related code from across the codebase and injects it into the crew.
# Enabled by default; set to "false" to disable and use AST-only context.
RAG_ENABLED=true

# Embedding provider:
#   "hashing"               — default, zero-dependency, offline (good for tests/local)
#   "gemini"                — Google gemini-embedding-001 (uses GEMINI_API_KEY; best quality)
#   "sentence-transformers" — local neural model (requires `pip install sentence-transformers`)
# The index records which embedder built it and re-indexes automatically if you switch.
RAG_EMBEDDER=hashing

# Model to load for the "gemini" or "sentence-transformers" providers.
# RAG_EMBEDDING_MODEL=models/gemini-embedding-001

# Dimension for the default hashing embedder (Default: 512).
RAG_EMBEDDING_DIM=512

# Optional cross-repository context: extra repo roots to index alongside the PR's repo.
# Comma- or OS-path-separator-delimited absolute paths. A change in one service can then
# be reviewed against callers and patterns in sibling services.
# RAG_REPO_ROOTS=/path/to/service-b,/path/to/shared-libs

# ── Interactive PR Bot (slash commands) ─────────────────────────────────────
# Author associations allowed to run cost-bearing/writing commands (/review, /ask,
# /improve, /compliance, /describe). /help is always allowed. Comma-separated.
BOT_ALLOWED_ASSOCIATIONS=OWNER,MEMBER,COLLABORATOR

# The bot's own GitHub login — comments from it are ignored to avoid feedback loops
# (needed when posting via a PAT rather than a GitHub App, whose comments are auto-detected).
# BOT_GITHUB_LOGIN=

# GitLab/Bitbucket have no GitHub-style author_association in their webhooks, so trusted
# users who may run cost-bearing commands there are listed by username (comma-separated).
# If unset, only /help is allowed on those platforms (fail closed).
# BOT_ALLOWED_USERS=alice,bob
# Extra bot usernames whose comments to ignore as self (feedback-loop guard), comma-separated.
# BOT_BOT_USERNAMES=

# Webhook authentication for non-GitHub platforms.
# GitLab: set the same value as the webhook's Secret Token (sent as X-Gitlab-Token).
# GITLAB_WEBHOOK_SECRET=
# Bitbucket does not sign webhooks — put this secret in the webhook URL as ?token=SECRET.
# BITBUCKET_WEBHOOK_SECRET=

# For live PR commands, clone the PR repo into an isolated temp dir so RAG/AST/governance
# index the real codebase (not the server's working dir). Set "false" to disable cloning.
BOT_CLONE_REPO=true

# ── AI Evaluation & LLM-as-a-Judge Configuration ───────────────────────────
# Model to use for DeepEval / G-Eval evaluations (Default: same as LLM_MODEL)
EVAL_LLM_MODEL=gemini/gemini-3.1-flash-lite-preview

# Optional: Alternate API keys if using independent evaluator models (e.g. OpenAI/Anthropic)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Production Observability & Tracing (Langfuse) ───────────────────────────
# Optional: Enable Langfuse live production trace monitoring
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
